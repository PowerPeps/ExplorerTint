#include <winver.h>
#include <winuser.h>
#include "version.h"
#include "src/resource.h"

ISOLATIONAWARE_MANIFEST_RESOURCE_ID RT_MANIFEST "ExplorerTint.manifest"

// Texts are set at run time in the user interface language.
IDD_SETTINGS DIALOGEX 0, 0, 290, 355
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ExplorerTint"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_OPTIONS_H, 7, 7, 276, 10
    CONTROL         "", IDC_GIT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 20, 10, 10
    LTEXT           "", IDC_GIT + IDC_LABEL_OFFSET, 26, 21, 254, 10, SS_NOTIFY
    CONTROL         "", IDC_SYSLAST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 33, 10, 10
    LTEXT           "", IDC_SYSLAST + IDC_LABEL_OFFSET, 26, 34, 254, 10, SS_NOTIFY
    CONTROL         "", IDC_HIDENAMES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 46, 10, 10
    LTEXT           "", IDC_HIDENAMES + IDC_LABEL_OFFSET, 26, 47, 254, 10, SS_NOTIFY
    CONTROL         "", IDC_CLASSIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 59, 10, 10
    LTEXT           "", IDC_CLASSIC + IDC_LABEL_OFFSET, 26, 60, 254, 10, SS_NOTIFY
    CONTROL         "", IDC_RIBBON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 72, 10, 10
    LTEXT           "", IDC_RIBBON + IDC_LABEL_OFFSET, 26, 73, 254, 10, SS_NOTIFY
    CONTROL         "", IDC_REPOICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 85, 10, 10
    LTEXT           "", IDC_REPOICON + IDC_LABEL_OFFSET, 26, 86, 254, 10, SS_NOTIFY

    LTEXT           "", IDC_COLORS_H, 7, 105, 100, 10
    LTEXT           "", IDC_TEXT_H, 110, 105, 80, 10
    LTEXT           "", IDC_BACK_H, 195, 105, 85, 10
    LTEXT           "", IDC_STAGED_L, 12, 120, 95, 10
    EDITTEXT        IDC_COLOR_FIRST + 0, 110, 118, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 0 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 172, 118, 16, 13
    EDITTEXT        IDC_COLOR_FIRST + 1, 195, 118, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 1 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 118, 16, 13
    LTEXT           "", IDC_UNTRACKED_L, 12, 136, 95, 10
    EDITTEXT        IDC_COLOR_FIRST + 2, 110, 134, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 2 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 172, 134, 16, 13
    EDITTEXT        IDC_COLOR_FIRST + 3, 195, 134, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 3 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 134, 16, 13
    LTEXT           "", IDC_IGNORED_L, 12, 152, 95, 10
    EDITTEXT        IDC_COLOR_FIRST + 4, 110, 150, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 4 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 172, 150, 16, 13
    EDITTEXT        IDC_COLOR_FIRST + 5, 195, 150, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 5 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 150, 16, 13
    LTEXT           "", IDC_SYSTEM_L, 12, 168, 95, 10
    EDITTEXT        IDC_COLOR_FIRST + 6, 110, 166, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 6 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 172, 166, 16, 13
    EDITTEXT        IDC_COLOR_FIRST + 7, 195, 166, 60, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_COLOR_FIRST + 7 + IDC_SWATCH_OFFSET, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 166, 16, 13

    LTEXT           "", IDC_NAMES_L, 7, 187, 276, 10
    EDITTEXT        IDC_NAMES, 12, 198, 268, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_GITPATH_L, 7, 217, 276, 10
    EDITTEXT        IDC_GITPATH, 12, 228, 268, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_FOLDERICONS_L, 7, 247, 276, 10
    EDITTEXT        IDC_FOLDERICONS, 12, 258, 268, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_ICONROOTS_L, 7, 277, 276, 10
    EDITTEXT        IDC_ICONROOTS, 12, 288, 268, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_NOTE, 7, 307, 276, 24

    PUSHBUTTON      "", IDC_DEFAULTS, 12, 335, 64, 14
    DEFPUSHBUTTON   "", IDOK, 124, 335, 50, 14
    PUSHBUTTON      "", IDCANCEL, 177, 335, 50, 14
    PUSHBUTTON      "", IDC_APPLY, 230, 335, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    EXPLORERTINT_VER_MAJOR, EXPLORERTINT_VER_MINOR, EXPLORERTINT_VER_PATCH, EXPLORERTINT_VER_BUILD
 PRODUCTVERSION EXPLORERTINT_VER_MAJOR, EXPLORERTINT_VER_MINOR, EXPLORERTINT_VER_PATCH, EXPLORERTINT_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ExplorerTint"
            VALUE "FileDescription",  "ExplorerTint - Windows Explorer visual tweaks"
            VALUE "FileVersion",      EXPLORERTINT_VER_STRING
            VALUE "InternalName",     "ExplorerTint"
            VALUE "OriginalFilename", "ExplorerTint.dll"
            VALUE "ProductName",      "ExplorerTint"
            VALUE "ProductVersion",   EXPLORERTINT_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
